---
import Layout from '../layouts/Layout.astro';

const tiles = [
  {
    href: '/career',
    title: 'Career',
    blurb: 'Building products at FOLO and Niyo — onboarding, engagement, and launches.',
  },
  {
    href: '/180dc',
    title: '180DC',
    blurb: 'Global Leadership Team, Branch Pairing, and the projects around it.',
  },
  {
    href: '/travel',
    title: 'Travel',
    blurb: 'Trips, notes, and photos from the road.',
  },
];
---

<Layout>
  <section class="hero">
    <h1>Lakshya Tiwari</h1>
    <p class="intro">Associate Product Manager at FOLO, working on onboarding and growth.</p>
  </section>

  <ul class="tiles">
    {
      tiles.map((tile) => (
        <li>
          <a href={tile.href}>
            <h2>{tile.title} <span class="arrow" aria-hidden="true">→</span></h2>
            <p class="muted">{tile.blurb}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .hero {
    margin-bottom: 4rem;
  }

  .intro {
    font-size: 1.25rem;
    color: var(--muted);
    max-width: 32rem;
  }

  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tiles li {
    border-top: 1px solid var(--hairline);
  }

  .tiles li:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .tiles a {
    display: block;
    padding: 1.75rem 0;
    text-decoration: none;
  }

  .tiles h2 {
    margin: 0 0 0.35rem;
    transition: color 0.15s;
  }

  .tiles p {
    margin: 0;
  }

  .arrow {
    display: inline-block;
    font-size: 0.8em;
    transition: transform 0.15s;
  }

  .tiles a:hover h2 {
    color: var(--accent);
  }

  .tiles a:hover .arrow {
    transform: translateX(4px);
  }
</style>
