---
import fs from 'node:fs';
import Layout from '../layouts/Layout.astro';

// Drop a portrait at public/images/portrait.jpg and it replaces the monogram.
const PHOTO = '/images/portrait.jpg';
const hasPhoto = fs.existsSync(new URL(`../../public${PHOTO}`, import.meta.url));

const sections = [
  {
    href: '/career',
    title: 'Career',
    blurb: 'Building products at FOLO and Niyo — onboarding, engagement, and launches.',
    color: 'var(--ink)',
  },
  {
    href: '/180dc',
    title: '180DC',
    blurb: 'Global Leadership Team, Branch Pairing, and the projects around it.',
    color: 'var(--dc-green)',
  },
  {
    href: '/travel',
    title: 'Travel',
    blurb: 'Trips, notes, and photos from the road.',
    color: 'var(--coral)',
  },
];
---

<Layout tone="home">
  <section class="hero">
    <div class="portrait rise">
      {
        hasPhoto ? (
          <img src={PHOTO} alt="Portrait of Lakshya Tiwari" width="352" height="352" fetchpriority="high" />
        ) : (
          <span class="monogram" aria-hidden="true">LT</span>
        )
      }
    </div>
    <h1 class="rise rise-2">Lakshya Tiwari</h1>
    <p class="intro rise rise-3">
      Product manager on a founding team, building things people come back to.
    </p>
    <p class="hero-links rise rise-4">
      <a href="/career">Read my story</a>
      <span aria-hidden="true">·</span>
      <a href="https://www.linkedin.com/in/lakshya-tiwari/" target="_blank" rel="noopener">LinkedIn</a>
    </p>
  </section>

  <ol class="sections rise rise-4">
    {
      sections.map((section, i) => (
        <li style={`--section: ${section.color}`}>
          <a href={section.href}>
            <span class="index">{String(i + 1).padStart(2, '0')}</span>
            <span class="body">
              <h2>{section.title}</h2>
              <p>{section.blurb}</p>
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))
    }
  </ol>
</Layout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem 0 5rem;
  }

  .portrait {
    width: 11rem;
    height: 11rem;
    margin-bottom: 2.25rem;
    border-radius: 50%;
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 0 0 6px var(--bg), 0 0 0 7px var(--hairline);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
    display: block;
  }

  .monogram {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-family: var(--font-heading);
    font-size: 3.25rem;
    letter-spacing: -0.03em;
    color: var(--muted);
  }

  .hero h1 {
    margin-bottom: 1rem;
  }

  .intro {
    max-width: 30rem;
    margin: 0 auto 1.75rem;
    font-size: clamp(1.15rem, 2.4vw, 1.35rem);
    line-height: 1.55;
    color: var(--muted);
  }

  .hero-links {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    font-size: 0.95rem;
  }

  .hero-links span {
    color: var(--hairline);
  }

  .sections {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }

  .sections li {
    border-bottom: 1px solid var(--hairline);
  }

  .sections a {
    display: grid;
    grid-template-columns: 2.75rem 1fr auto;
    align-items: baseline;
    gap: 0.5rem;
    padding: 1.9rem 0;
    text-decoration: none;
  }

  .index {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--section);
    font-variant-numeric: tabular-nums;
  }

  .sections h2 {
    margin: 0 0 0.3rem;
    transition: color 0.2s;
  }

  .sections p {
    margin: 0;
    color: var(--muted);
  }

  .arrow {
    align-self: center;
    font-size: 1.25rem;
    color: var(--muted);
    transition:
      transform 0.25s,
      color 0.2s;
  }

  .sections a:hover h2,
  .sections a:hover .arrow {
    color: var(--section);
  }

  .sections a:hover .arrow {
    transform: translateX(6px);
  }
</style>
