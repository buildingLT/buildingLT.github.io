---
import Layout from '../layouts/Layout.astro';
import Stamp from '../components/Stamp.astro';

// Two lines styled after a passport's machine-readable zone, padded with "<" to 44 characters.
const mrz = (text: string) => text.padEnd(44, '<');
const mrzLines = [mrz('P<INDTIWARI<<LAKSHYA'), mrz('PRODUCT<<ONBOARDING<<GROWTH<<BENGALURU')];

const details = [
  { term: 'Now', value: 'Associate Product Manager at FOLO' },
  { term: 'Before', value: 'Forex cards at Niyo' },
  { term: 'Based in', value: 'Bengaluru' },
];

const sections = [
  {
    href: '/career',
    label: 'Career',
    date: 'Since Dec 2024',
    ink: 'var(--navy)',
    shape: 'rect',
    tilt: -4,
    blurb: 'Onboarding and growth at FOLO and Niyo.',
  },
  {
    href: '/180dc',
    label: '180DC',
    date: 'Since Sep 2024',
    ink: 'var(--dc-green-deep)',
    shape: 'oval',
    tilt: 3,
    blurb: 'Founding a branch, then the Global Leadership Team.',
  },
  {
    href: '/travel',
    label: 'Travel',
    date: 'Always open',
    ink: 'var(--vermilion)',
    shape: 'double',
    tilt: -2,
    blurb: 'Trips, notes and photos from the road.',
  },
] as const;
---

<Layout tone="home">
  <section class="datapage" aria-label="About Lakshya">
    <img
      class="photo"
      src="/images/portrait.jpg"
      alt="Portrait of Lakshya Tiwari"
      width="560"
      height="720"
      fetchpriority="high"
    />
    <div class="fields">
      <h1>Lakshya Tiwari</h1>
      <p class="intro">
        Product manager on a founding team, building things people come back to.
      </p>
      <dl>
        {
          details.map((d) => (
            <div>
              <dt>{d.term}</dt>
              <dd>{d.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="mrz" aria-hidden="true">
      {mrzLines.map((line) => <span>{line}</span>)}
    </div>
  </section>

  <ul class="visas">
    {
      sections.map((s, i) => (
        <li>
          <Stamp
            href={s.href}
            label={s.label}
            date={s.date}
            ink={s.ink}
            shape={s.shape}
            tilt={s.tilt}
            land
            delay={250 + i * 140}
          />
          <p>{s.blurb}</p>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .datapage {
    display: grid;
    grid-template-columns: 12.5rem 1fr;
    grid-template-areas:
      'photo fields'
      'mrz mrz';
    gap: 2.5rem 2.75rem;
    align-items: start;
  }

  .photo {
    grid-area: photo;
    width: 100%;
    height: auto;
    aspect-ratio: 35 / 45;
    object-fit: cover;
    border-radius: 3px;
    filter: saturate(0.92);
  }

  .fields {
    grid-area: fields;
  }

  .fields h1 {
    margin-bottom: 0.9rem;
  }

  .intro {
    max-width: 30rem;
    font-size: clamp(1.2rem, 2.4vw, 1.45rem);
    line-height: 1.5;
  }

  dl {
    display: grid;
    gap: 0.35rem;
    margin: 1.75rem 0 0;
  }

  dl div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
  }

  dt {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--muted);
    padding-top: 0.15rem;
  }

  dd {
    margin: 0;
  }

  /* The one bold element: a machine-readable strip across the data page */
  .mrz {
    grid-area: mrz;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    overflow: hidden;
    container-type: inline-size;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    line-height: 1.35;
    white-space: nowrap;
    color: color-mix(in srgb, var(--navy) 78%, var(--paper));
  }

  /* Size the 44 characters (0.6em advance + 0.08em tracking, with slack) to fill the row */
  .mrz span {
    font-size: calc(100cqi / (44 * 0.7));
  }

  .visas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    list-style: none;
    margin: 5rem 0 0;
    padding: 0;
  }

  .visas li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .visas p {
    margin: 0;
    max-width: 16rem;
    color: var(--muted);
  }

  @media (max-width: 44rem) {
    .datapage {
      grid-template-columns: 1fr;
      grid-template-areas:
        'photo'
        'fields'
        'mrz';
      gap: 1.75rem;
    }

    .photo {
      width: 9rem;
    }

    .visas {
      grid-template-columns: 1fr;
      gap: 2.75rem;
      margin-top: 3.5rem;
    }

  }
</style>
