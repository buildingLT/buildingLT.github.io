---
import Layout from '../layouts/Layout.astro';

const tiles = [
  {
    href: '/career',
    title: 'Career',
    color: 'blue',
    blurb: 'Building products at FOLO and Niyo — onboarding, engagement, and launches.',
  },
  {
    href: '/180dc',
    title: '180DC',
    color: 'green',
    blurb: 'Global Leadership Team, Branch Pairing, and the projects around it.',
  },
  {
    href: '/travel',
    title: 'Travel',
    color: 'coral',
    blurb: 'Trips, notes, and photos from the road.',
  },
];
---

<Layout tone="home">
  <section class="hero">
    <h1>Lakshya Tiwari</h1>
    <p class="intro">Product manager on a founding team, building things people come back to.</p>
  </section>

  <ul class="tiles">
    {
      tiles.map((tile) => (
        <li style={`--tile: var(--${tile.color})`}>
          <a href={tile.href}>
            <h2>{tile.title} <span class="arrow" aria-hidden="true">→</span></h2>
            <p class="muted">{tile.blurb}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .hero {
    margin-bottom: 4rem;
  }

  .hero h1 {
    display: inline-block;
    background: linear-gradient(95deg, var(--text) 30%, var(--blue) 65%, var(--coral));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .intro {
    margin-top: 0.5rem;
    font-size: 1.25rem;
    color: var(--muted);
    max-width: 32rem;
  }

  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tiles li {
    border-top: 1px solid var(--hairline);
  }

  .tiles li:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .tiles a {
    display: block;
    padding: 1.75rem 0;
    text-decoration: none;
  }

  .tiles h2 {
    margin: 0 0 0.35rem;
    transition: color 0.15s;
  }

  .tiles p {
    margin: 0;
  }

  .arrow {
    display: inline-block;
    color: var(--tile);
    font-size: 0.8em;
    transition: transform 0.15s;
  }

  .tiles a:hover h2 {
    color: var(--tile);
  }

  .tiles a:hover .arrow {
    transform: translateX(4px);
  }
</style>
