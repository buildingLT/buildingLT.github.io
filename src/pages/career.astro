---
import Layout from '../layouts/Layout.astro';

const experience = [
  {
    company: 'FOLO',
    detail: 'Finuture Technologies · India’s first NetWorth app',
    role: 'Associate Product Manager, Onboarding & Growth',
    dates: 'Aug 2025 – present',
    location: 'Bengaluru',
    points: [
      'Own onboarding conversions end to end. Ran A/B experiments and flow revamps across the onboarding journey, lifting install-to-account-linking conversion by <strong>15%</strong>.',
      'Scaled FOLO from a closed beta of 5K users to <strong>1.3L+</strong> users, about <strong>20%</strong> of them organic, at a blended CPI of <strong>₹30</strong>.',
      'Built the analytics stack on BigQuery and Metabase: user profiling, product dashboards, API monitoring, and automated alerts and reporting.',
      'Lead engagement through campaigns for new features, including NetWorth Insights and personalised account reminders over push, email, WhatsApp and RCS, improving stickiness by <strong>4%</strong>.',
    ],
  },
  {
    company: 'Niyo',
    detail: 'Niyo Solutions',
    role: 'Product Management Intern, Forex Cards',
    dates: 'Dec 2024 – Jul 2025',
    location: 'Bengaluru',
    points: [
      'Built <strong>Niyo Express</strong>, a premium forex-card concierge service, from 0 to <strong>5K+</strong> leads across Indian metros. Set up lead attribution and ran pricing A/B experiments to refine the model.',
      'Managed the end-to-end migration of <strong>7K+</strong> users and <strong>₹5.8 Cr+</strong> in balances from Equitas to Niyo’s DCB and SBM partner banks, working directly with CXOs.',
      'Wrote product specs for the app revamp and defined user flows to improve feature discoverability for about <strong>400K</strong> MAUs.',
    ],
  },
];

const projects = [
  {
    title: 'Harvard Project for Asian & International Relations',
    meta: 'Delegate · Feb 2024',
    text: 'One of 500 global delegates, representing social impact consulting at Harvard. Presented an expansion strategy for Clav (YC 24), a financial operating system for non-profits.',
  },
  {
    title: 'Summer Project, IIT Guwahati',
    meta: 'May 2024',
    text: 'Operational feasibility analysis and market-entry strategy for a European low-cost airline.',
  },
  {
    title: 'Socialis Impulsum, 180DC IIT Madras',
    meta: 'Apr 2024',
    text: 'Top 2% for root-cause analysis; proposed GTM and pricing strategy for an online tutoring platform.',
  },
  {
    title: 'Indian Case Challenge, IIT Kharagpur',
    meta: 'Jan 2023',
    text: 'Vertical-integration strategy for Tata on India’s semiconductor problem.',
  },
  {
    title: 'Espresso',
    meta: 'With IIT KGP and IIML founders · Jan 2022',
    text: 'Designed product features and acquisition strategy for an app that reached about 10,000 users in two weeks.',
  },
];
---

<Layout tone="career" title="Career" description="Lakshya Tiwari's career in product — FOLO and Niyo.">
  <h1>Career</h1>
  <p class="lede">
    I work on onboarding and growth: the first few minutes that decide whether someone sticks
    around. Right now that’s at FOLO, before that forex cards at Niyo.
  </p>

  {
    experience.map((job) => (
      <section class="job">
        <h2>{job.company}</h2>
        <p class="meta">
          {job.role}
          <br />
          {job.detail} · {job.dates} · {job.location}
        </p>
        <ul>
          {job.points.map((point) => (
            <li set:html={point} />
          ))}
        </ul>
      </section>
    ))
  }

  <hr />

  <h2>Consulting & projects</h2>
  <p class="muted">
    Alongside college I founded 180 Degrees Consulting at NIT Warangal — that story has <a
      href="/180dc">its own page</a>.
  </p>
  <dl class="projects">
    {
      projects.map((project) => (
        <div>
          <dt>{project.title}</dt>
          <dd class="meta">{project.meta}</dd>
          <dd>{project.text}</dd>
        </div>
      ))
    }
  </dl>

  <hr />

  <h2>Education</h2>
  <p>
    National Institute of Technology Warangal
    <br />
    <span class="muted">B.Tech, Chemical Engineering · 2021 – 2025</span>
  </p>
</Layout>

<style>
  .lede {
    font-size: 1.2rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .job h2 {
    margin-bottom: 0.25rem;
  }

  .meta {
    color: var(--muted);
    font-size: 0.95rem;
  }

  ul {
    padding-left: 1.1rem;
    margin: 0;
  }

  li {
    margin-bottom: 0.75rem;
  }

  li::marker {
    color: var(--accent);
  }

  li :global(strong) {
    font-weight: 500;
  }

  .projects {
    margin: 1.5rem 0 0;
  }

  .projects div {
    margin-bottom: 1.5rem;
  }

  .projects dt {
    font-weight: 500;
  }

  .projects dd {
    margin: 0;
  }
</style>
