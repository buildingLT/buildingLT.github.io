---
import Layout from '../layouts/Layout.astro';
import Stamp from '../components/Stamp.astro';
---

<Layout tone="travel" title="Travel" description="Trip writeups and photos.">
  <article class="prose">
    <Stamp label="Travel" date="Always open" ink="var(--vermilion)" shape="double" tilt={-2} />
    <h1>Notes from the road.</h1>
    <p class="lede">Trip writeups and photos. The first one is on its way.</p>
  </article>
</Layout>

<style>
  article > :global(.stamp) {
    margin-bottom: 2.25rem;
  }
</style>
