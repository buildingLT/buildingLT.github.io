---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Sets the page's accent ink */
  tone?: 'home' | 'career' | '180dc' | 'travel';
}

const {
  title,
  description = 'Lakshya Tiwari — product, consulting, and travel.',
  tone = 'home',
} = Astro.props;

const pageTitle = title ? `${title} | Lakshya Tiwari` : 'Lakshya Tiwari';

const LINKEDIN_URL = 'https://www.linkedin.com/in/lakshya-tiwari/';
const EMAIL = 'lakshya.tiwari1201@gmail.com';

const nav = [
  { href: '/career', label: 'Career' },
  { href: '/180dc', label: '180DC' },
  { href: '/travel', label: 'Travel' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=IBM+Plex+Mono&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
  </head>
  <body data-tone={tone}>
    <header class="container site-header">
      <a href="/" class="name">Lakshya Tiwari</a>
      <nav>
        {
          nav.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="container site-footer">
      <p>
        Write to me at <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </p>
      <a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-top: 1.75rem;
    padding-bottom: 3.5rem;
    font-family: var(--font-display);
  }

  .name {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .name:hover {
    color: var(--navy);
  }

  nav {
    display: flex;
    gap: 1.4rem;
    font-size: 1rem;
  }

  nav a {
    text-decoration: none;
    color: var(--muted);
    padding-bottom: 0.2rem;
    border-bottom: 2px solid transparent;
  }

  nav a:hover {
    color: var(--navy);
  }

  nav a[aria-current='page'] {
    color: var(--navy);
    border-bottom-color: var(--gold);
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 2rem;
    margin-top: 7rem;
    padding-bottom: 3rem;
    font-size: 1rem;
    color: var(--muted);
  }

  .site-footer p {
    margin: 0;
  }

  @media (max-width: 480px) {
    nav {
      gap: 1rem;
    }
  }
</style>
