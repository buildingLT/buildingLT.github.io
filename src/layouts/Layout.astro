---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Sets the page's accent colour; travel also gets a soft wash behind the header. */
  tone?: 'home' | 'career' | '180dc' | 'travel';
}

const {
  title,
  description = 'Lakshya Tiwari — product, consulting, and travel.',
  tone = 'home',
} = Astro.props;

const pageTitle = title ? `${title} · Lakshya Tiwari` : 'Lakshya Tiwari';

const LINKEDIN_URL = 'https://www.linkedin.com/in/lakshya-tiwari/';
const EMAIL = 'lakshya.tiwari1201@gmail.com';

const nav = [
  { href: '/career', label: 'Career' },
  { href: '/180dc', label: '180DC' },
  { href: '/travel', label: 'Travel' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Inter:wght@400;500&display=swap"
    />
  </head>
  <body data-tone={tone}>
    {tone === 'travel' && <div class="wash" aria-hidden="true" />}
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="name">Lakshya Tiwari</a>
        <nav>
          {
            nav.map((item) => (
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="container site-footer">
      <p class="sign-off">Say hello — I’m always up for a good conversation about products.</p>
      <div class="footer-row">
        <span class="muted">© {new Date().getFullYear()} Lakshya Tiwari</span>
        <span class="footer-links">
          <a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a>
          <a href={`mailto:${EMAIL}`}>Email</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--hairline) 70%, transparent);
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    height: 4rem;
  }

  .name {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .name:hover {
    color: var(--text);
  }

  nav {
    display: flex;
    gap: 1.4rem;
    font-size: 0.925rem;
  }

  nav a {
    position: relative;
    text-decoration: none;
    color: var(--muted);
  }

  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.3rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.25s;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }

  nav a:hover::after,
  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  main {
    padding-top: 4.5rem;
  }

  .site-footer {
    margin-top: 6rem;
    padding-top: 2.5rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--hairline);
  }

  .sign-off {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    line-height: 1.35;
    max-width: 26rem;
    margin-bottom: 1.75rem;
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.9rem;
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
  }

  @media (max-width: 480px) {
    nav {
      gap: 1rem;
    }
  }
</style>
